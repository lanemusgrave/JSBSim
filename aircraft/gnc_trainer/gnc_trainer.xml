<?xml version="1.0"?>
<!--
  gnc_trainer: a ~11 kg, 2.9 m span fixed-wing UAS for the JSBSim GNC curriculum.
  GENERATED by modules/07_build_uas_model/solutions/build_gnc_trainer.py - edit the
  generator, not this file.

  Data: Aerosonde-class parameters from Beard & McLain, "Small Unmanned Aircraft:
  Theory and Practice" (Princeton, 2012), as published in mavsim_public.
  Structural frame: origin at the propeller hub, x aft, y right, z up.
-->
<fdm_config name="gnc_trainer" version="2.0" release="BETA">

  <fileheader>
    <author> JSBSim GNC Lab (generated) </author>
    <description> Small fixed-wing UAS, Aerosonde-class (Beard &amp; McLain) </description>
    <reference refID="BM2012" author="R. Beard, T. McLain" title="Small Unmanned Aircraft: Theory and Practice" date="2012"/>
  </fileheader>

  <metrics>
    <wingarea unit="M2"> 0.55 </wingarea>
    <wingspan unit="M"> 2.8956 </wingspan>
    <chord unit="M"> 0.18994 </chord>
    <location name="AERORP" unit="M"> <x> 0.4 </x> <y> 0 </y> <z> 0 </z> </location>
    <location name="VRP" unit="M"> <x> 0.4 </x> <y> 0 </y> <z> 0 </z> </location>
  </metrics>

  <!-- negated_crossproduct_inertia="false": ixz = +integral(x z dm), the
       textbook (Beard & McLain) definition.  JSBSim's default ("true") expects
       the opposite sign - a classic source of wrong roll/yaw coupling. -->
  <mass_balance negated_crossproduct_inertia="false">
    <ixx unit="KG*M2"> 0.8244 </ixx>
    <iyy unit="KG*M2"> 1.135 </iyy>
    <izz unit="KG*M2"> 1.759 </izz>
    <ixz unit="KG*M2"> 0.1204 </ixz>
    <emptywt unit="KG"> 11.0 </emptywt>
    <location name="CG" unit="M"> <x> 0.4 </x> <y> 0 </y> <z> 0 </z> </location>
    <pointmass name="PAYLOAD">
      <description> Movable payload/ballast for CG and weight dispersions (default 0) </description>
      <weight unit="KG"> 0.0 </weight>
      <location unit="M"> <x> 0.4 </x> <y> 0 </y> <z> 0 </z> </location>
    </pointmass>
  </mass_balance>

  <ground_reactions>
    <!-- Belly-landing skids; the vehicle is air-launched in all lessons. -->
    <contact type="STRUCTURE" name="NOSE_SKID">
      <location unit="M"> <x> 0.10 </x> <y> 0 </y> <z> -0.12 </z> </location>
      <static_friction> 0.6 </static_friction> <dynamic_friction> 0.5 </dynamic_friction>
      <spring_coeff unit="N/M"> 8000 </spring_coeff> <damping_coeff unit="N/M/SEC"> 300 </damping_coeff>
    </contact>
    <contact type="STRUCTURE" name="TAIL_SKID">
      <location unit="M"> <x> 1.60 </x> <y> 0 </y> <z> -0.05 </z> </location>
      <static_friction> 0.6 </static_friction> <dynamic_friction> 0.5 </dynamic_friction>
      <spring_coeff unit="N/M"> 4000 </spring_coeff> <damping_coeff unit="N/M/SEC"> 150 </damping_coeff>
    </contact>
    <contact type="STRUCTURE" name="LEFT_TIP">
      <location unit="M"> <x> 0.45 </x> <y> -1.448 </y> <z> 0.05 </z> </location>
      <static_friction> 0.6 </static_friction> <dynamic_friction> 0.5 </dynamic_friction>
      <spring_coeff unit="N/M"> 4000 </spring_coeff> <damping_coeff unit="N/M/SEC"> 150 </damping_coeff>
    </contact>
    <contact type="STRUCTURE" name="RIGHT_TIP">
      <location unit="M"> <x> 0.45 </x> <y> 1.448 </y> <z> 0.05 </z> </location>
      <static_friction> 0.6 </static_friction> <dynamic_friction> 0.5 </dynamic_friction>
      <spring_coeff unit="N/M"> 4000 </spring_coeff> <damping_coeff unit="N/M/SEC"> 150 </damping_coeff>
    </contact>
  </ground_reactions>

  <!-- Placeholder engine: produces nothing, but gives JSBSim's trim routine a
       throttle (fcs/throttle-cmd-norm) to adjust.  Real thrust is below. -->
  <propulsion>
    <engine file="gnc_dummy_motor">
      <feed> 0 </feed>
      <thruster file="gnc_direct">
        <location unit="M"> <x> 0.0 </x> <y> 0 </y> <z> 0 </z> </location>
        <orient unit="DEG"> <roll> 0 </roll> <pitch> 0 </pitch> <yaw> 0 </yaw> </orient>
      </thruster>
    </engine>
    <tank type="FUEL">
      <location unit="M"> <x> 0.4 </x> <y> 0 </y> <z> 0 </z> </location>
      <capacity unit="KG"> 0.001 </capacity>
      <contents unit="KG"> 0.001 </contents>
    </tank>
  </propulsion>

  <!-- ===== Motor + propeller (Beard & McLain propulsion addendum) ===== -->
  <system name="motor-prop">
    <channel name="Propulsion">
      <fcs_function name="propulsion/rho-kgm3">
        <function> <product> <property> atmosphere/rho-slugs_ft3 </property> <value> 515.379 </value> </product> </function>
      </fcs_function>
      <fcs_function name="propulsion/Va-mps">
        <function> <product> <property> velocities/u-aero-fps </property> <value> 0.3048 </value> </product> </function>
      </fcs_function>
      <!-- quadratic in Omega: a, b, c -->
      <fcs_function name="propulsion/a">
        <function> <product> <property> propulsion/rho-kgm3 </property>  <value> 4.481883e-06 </value> </product> </function>
      </fcs_function>
      <fcs_function name="propulsion/b">
        <function> <sum> <product> <property> propulsion/rho-kgm3 </property> <property> propulsion/Va-mps </property> <value> 5.2678254e-05 </value> </product> <value> 0.10326603 </value> </sum> </function>
      </fcs_function>
      <fcs_function name="propulsion/c">
        <function>
          <sum>
            <product> <property> propulsion/rho-kgm3 </property> <property> propulsion/Va-mps </property>
                      <property> propulsion/Va-mps </property> <value> -0.002181446 </value> </product>
            <product> <property> fcs/throttle-pos-norm </property> <value> -69.620487 </value> </product>
            <value> 0.098785827 </value>
          </sum>
        </function>
      </fcs_function>
      <fcs_function name="propulsion/omega-rad_sec">
        <description> Omega = (-b + sqrt(b^2 - 4ac)) / 2a, floored at 0 </description>
        <function>
          <max>
            <value> 0 </value>
            <quotient>
              <difference>
                <pow>
                  <max> <value> 0 </value>
                    <difference>
                      <product> <property> propulsion/b </property> <property> propulsion/b </property> </product>
                      <product> <value> 4 </value> <property> propulsion/a </property> <property> propulsion/c </property> </product>
                    </difference>
                  </max>
                  <value> 0.5 </value>
                </pow>
                <property> propulsion/b </property>
              </difference>
              <product> <value> 2 </value> <property> propulsion/a </property> </product>
            </quotient>
          </max>
        </function>
      </fcs_function>
      <fcs_function name="propulsion/thrust-N">
        <function>
          <product> <property> propulsion/rho-kgm3 </property>
            <sum>
              <product> <property> propulsion/omega-rad_sec </property> <property> propulsion/omega-rad_sec </property> <value> 0.00015784533 </value> </product>
              <product> <property> propulsion/omega-rad_sec </property> <property> propulsion/Va-mps </property> <value> -0.0012610599 </value> </product>
              <product> <property> propulsion/Va-mps </property> <property> propulsion/Va-mps </property> <value> -0.027845106 </value> </product>
            </sum>
          </product>
        </function>
      </fcs_function>
      <fcs_function name="propulsion/torque-Nm">
        <function>
          <product> <property> propulsion/rho-kgm3 </property>
            <sum>
              <product> <property> propulsion/omega-rad_sec </property> <property> propulsion/omega-rad_sec </property> <value> 4.481883e-06 </value> </product>
              <product> <property> propulsion/omega-rad_sec </property> <property> propulsion/Va-mps </property> <value> 5.2678254e-05 </value> </product>
              <product> <property> propulsion/Va-mps </property> <property> propulsion/Va-mps </property> <value> -0.002181446 </value> </product>
            </sum>
          </product>
        </function>
      </fcs_function>
      <fcs_function name="propulsion/rpm">
        <function> <product> <property> propulsion/omega-rad_sec </property> <value> 9.5492966 </value> </product> </function>
      </fcs_function>
      <fcs_function name="propulsion/current-A">
        <function>
          <quotient>
            <difference>
              <product> <property> fcs/throttle-pos-norm </property> <value> 44.4 </value> </product>
              <product> <property> propulsion/omega-rad_sec </property> <value> 0.065857218 </value> </product>
            </difference>
            <value> 0.042 </value>
          </quotient>
        </function>
      </fcs_function>
    </channel>
  </system>

  <!-- Thrust along the shaft and the motor reaction torque on the airframe. -->
  <external_reactions>
    <force name="propeller" frame="BODY">
      <function> <product> <property> propulsion/thrust-N </property> <value> 0.224809 </value> </product> </function>
      <location unit="M"> <x> 0.0 </x> <y> 0 </y> <z> 0 </z> </location>
      <direction> <x> 1 </x> <y> 0 </y> <z> 0 </z> </direction>
    </force>
    <moment name="prop_torque" frame="BODY">
      <function> <product> <property> propulsion/torque-Nm </property> <value> 0.737562 </value> </product> </function>
      <direction> <x> -1 </x> <y> 0 </y> <z> 0 </z> </direction>
    </moment>
  </external_reactions>

  <flight_control name="gnc_trainer FCS">
    <!-- Normalized commands (-1..1, throttle 0..1) -> surface angles [rad].
         Trim inputs are summed in so JSBSim's trim routine can use them. -->
    <property value="0"> fcs/actuators-on </property>
    <channel name="Pitch">
      <summer name="fcs/elevator-sum">
        <input> fcs/elevator-cmd-norm </input>
        <input> fcs/pitch-trim-cmd-norm </input>
        <clipto> <min> -1 </min> <max> 1 </max> </clipto>
      </summer>
      <aerosurface_scale name="fcs/elevator-cmd-rad">
        <input> fcs/elevator-sum </input>
        <range> <min> -0.43633 </min> <max> 0.43633 </max> </range>
      </aerosurface_scale>
      <!-- Actuator model: first-order lag + rate limit + travel limit. -->
      <actuator name="fcs/elevator-actuator">
        <input> fcs/elevator-cmd-rad </input>
        <lag> 40.0 </lag>
        <rate_limit> 4.3633 </rate_limit>
        <clipto> <min> -0.43633 </min> <max> 0.43633 </max> </clipto>
      </actuator>
      <!-- fcs/actuators-on = 0 (default): ideal surfaces (needed for
           finite-difference linearization).  1: realistic actuators. -->
      <switch name="fcs/elevator-pos-select">
        <default value="fcs/elevator-cmd-rad"/>
        <test value="fcs/elevator-actuator"> fcs/actuators-on == 1 </test>
        <output> fcs/elevator-pos-rad </output>
      </switch>
    </channel>
    <channel name="Roll">
      <summer name="fcs/aileron-sum">
        <input> fcs/aileron-cmd-norm </input>
        <input> fcs/roll-trim-cmd-norm </input>
        <clipto> <min> -1 </min> <max> 1 </max> </clipto>
      </summer>
      <aerosurface_scale name="fcs/aileron-cmd-rad">
        <input> fcs/aileron-sum </input>
        <range> <min> -0.43633 </min> <max> 0.43633 </max> </range>
      </aerosurface_scale>
      <!-- Actuator model: first-order lag + rate limit + travel limit. -->
      <actuator name="fcs/aileron-actuator">
        <input> fcs/aileron-cmd-rad </input>
        <lag> 40.0 </lag>
        <rate_limit> 4.3633 </rate_limit>
        <clipto> <min> -0.43633 </min> <max> 0.43633 </max> </clipto>
      </actuator>
      <!-- fcs/actuators-on = 0 (default): ideal surfaces (needed for
           finite-difference linearization).  1: realistic actuators. -->
      <switch name="fcs/aileron-pos-select">
        <default value="fcs/aileron-cmd-rad"/>
        <test value="fcs/aileron-actuator"> fcs/actuators-on == 1 </test>
        <output> fcs/aileron-pos-rad </output>
      </switch>
    </channel>
    <channel name="Yaw">
      <summer name="fcs/rudder-sum">
        <input> fcs/rudder-cmd-norm </input>
        <input> fcs/yaw-trim-cmd-norm </input>
        <clipto> <min> -1 </min> <max> 1 </max> </clipto>
      </summer>
      <aerosurface_scale name="fcs/rudder-cmd-rad">
        <input> fcs/rudder-sum </input>
        <range> <min> -0.43633 </min> <max> 0.43633 </max> </range>
      </aerosurface_scale>
      <!-- Actuator model: first-order lag + rate limit + travel limit. -->
      <actuator name="fcs/rudder-actuator">
        <input> fcs/rudder-cmd-rad </input>
        <lag> 40.0 </lag>
        <rate_limit> 4.3633 </rate_limit>
        <clipto> <min> -0.43633 </min> <max> 0.43633 </max> </clipto>
      </actuator>
      <!-- fcs/actuators-on = 0 (default): ideal surfaces (needed for
           finite-difference linearization).  1: realistic actuators. -->
      <switch name="fcs/rudder-pos-select">
        <default value="fcs/rudder-cmd-rad"/>
        <test value="fcs/rudder-actuator"> fcs/actuators-on == 1 </test>
        <output> fcs/rudder-pos-rad </output>
      </switch>
    </channel>
  </flight_control>

  <!-- Autopilot / guidance live in fcs/gnc_autopilot.xml (Modules 09-12).
       gnclab points JSBSim's systems path at aircraft/gnc_trainer/fcs/, and you
       can point it at your own folder to fly your own autopilot. -->
  <system file="gnc_autopilot"/>

