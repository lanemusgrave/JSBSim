@@ -0,0 +1,57 @@
+# TestMovingAverage.py
+#
+# Test the <moving_average> flight control component.
+#
+# This program is free software; you can redistribute it and/or modify it under
+# the terms of the GNU General Public License as published by the Free Software
+# Foundation; either version 3 of the License, or (at your option) any later
+# version.
+#
+# This program is distributed in the hope that it will be useful, but WITHOUT
+# ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS
+# FOR A PARTICULAR PURPOSE.  See the GNU General Public License for more
+# details.
+#
+# You should have received a copy of the GNU General Public License along with
+# this program; if not, see <http://www.gnu.org/licenses/>
+#
+
+from JSBSim_utils import JSBSimTestCase, RunTest, FlightModel
+
+
+class TestMovingAverage(JSBSimTestCase):
+    def test_boxcar(self):
+        tripod = FlightModel(self, 'tripod')
+        tripod.include_system_test_file('moving_average.xml')
+        fdm = tripod.start()            # run_ic() primes the buffers with 0.0
+
+        history = [0.0]*4
+        for i in range(12):
+            v = 3.0 if i % 2 else float(i)
+            fdm['test/input'] = v
+            fdm.run()
+            history = history[1:] + [v]
+            self.assertAlmostEqual(fdm['test/avg-4'], sum(history)/4.0)
+            self.assertAlmostEqual(fdm['test/avg-1'], v)
+            self.assertAlmostEqual(fdm['test/avg-clipped'],
+                                   max(-1.0, min(1.0, sum(history)/4.0)))
+
+    def test_reset_forgets_past_samples(self):
+        tripod = FlightModel(self, 'tripod')
+        tripod.include_system_test_file('moving_average.xml')
+        fdm = tripod.start()
+        for _ in range(5):
+            fdm['test/input'] = 10.0
+            fdm.run()
+        self.assertAlmostEqual(fdm['test/avg-4'], 10.0)
+        # Reset re-runs the IC: declared properties return to their defaults
+        # (test/input = 0) and the buffer is re-primed with that value.
+        fdm.reset_to_initial_conditions(0)
+        self.assertAlmostEqual(fdm['test/avg-4'], 0.0)
+        fdm['test/input'] = -2.0
+        fdm.run()
+        # no trace of the 10.0 samples: [0, 0, 0, -2] / 4
+        self.assertAlmostEqual(fdm['test/avg-4'], -0.5)
+
+
+RunTest(TestMovingAverage)
