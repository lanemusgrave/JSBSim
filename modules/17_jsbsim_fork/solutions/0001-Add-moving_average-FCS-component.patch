+#ifndef FGMOVINGAVERAGE_H
+#define FGMOVINGAVERAGE_H
+
+#include <vector>
+
+#include "FGFCSComponent.h"
+
+namespace JSBSim {
+
+class FGFCS;
+class Element;
+
+/** Moving-average (boxcar) filter: the output is the mean of the last N
+    inputs, one sample per execution of the component's channel.
+
+    @code
+    <moving_average name="fcs/q-avg">
+      <input> {[-]property name} </input>
+      <samples> {integer >= 1} </samples>
+      [<clipto>
+        <min> {[-]property name | value} </min>
+        <max> {[-]property name | value} </max>
+      </clipto>]
+      [<output> {property} </output>]
+    </moving_average>
+    @endcode
+
+    A boxcar of N samples has a pure delay of (N-1)/2 samples and its first
+    spectral null at 1/(N dt).  After a reset (e.g. run_ic()) the buffer is
+    filled with the first input, so the filter starts without a transient.
+*/
+class FGMovingAverage : public FGFCSComponent
+{
+public:
+  FGMovingAverage(FGFCS* fcs, Element* element);
+  ~FGMovingAverage();
+
+  bool Run(void) override;
+  void ResetPastStates(void) override;
+
+private:
+  std::vector<double> buffer;
+  size_t next = 0;
+  bool primed = false;
+
+  void Debug(int from) override;
+};
+}
+#endif
