+ This program is distributed in the hope that it will be useful, but WITHOUT
+ ANY WARRANTY; without even the implied warranty of MERCHANTABILITY or FITNESS
+ FOR A PARTICULAR PURPOSE.  See the GNU Lesser General Public License for more
+ details.
+
+%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%*/
+
+#include <numeric>
+
+#include "FGMovingAverage.h"
+#include "models/FGFCS.h"
+#include "input_output/FGXMLElement.h"
+#include "input_output/FGLog.h"
+
+using namespace std;
+
+namespace JSBSim {
+
+FGMovingAverage::FGMovingAverage(FGFCS* fcs, Element* element)
+  : FGFCSComponent(fcs, element)
+{
+  CheckInputNodes(1, 1, element);
+
+  double n = 1.0;
+  if (element->FindElement("samples"))
+    n = element->FindElementValueAsNumber("samples");
+  if (n < 1.0) {
+    XMLLogException err(element);
+    err << "moving_average " << Name << ": <samples> must be >= 1\n";
+    throw err;
+  }
+  buffer.assign(static_cast<size_t>(n), 0.0);
+
+  bind(element, fcs->GetPropertyManager().get());
+  Debug(0);
+}
+
+//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
+
+FGMovingAverage::~FGMovingAverage()
+{
+  Debug(1);
+}
+
+//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
+
+void FGMovingAverage::ResetPastStates(void)
+{
+  FGFCSComponent::ResetPastStates();
+  primed = false;
+  next = 0;
+}
+
+//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
+
+bool FGMovingAverage::Run(void)
+{
+  Input = InputNodes[0]->getDoubleValue();
+
+  if (!primed) {                       // start at steady state: no start-up transient
+    buffer.assign(buffer.size(), Input);
+    primed = true;
+  }
+  buffer[next] = Input;
+  next = (next + 1) % buffer.size();
+
+  // Summing the whole (short) window each frame avoids the round-off drift of
+  // a running sum.
+  Output = accumulate(buffer.begin(), buffer.end(), 0.0) / buffer.size();
+
+  Clip();
+  SetOutput();
+
+  return true;
+}
+
+//%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
+
+void FGMovingAverage::Debug(int from)
+{
+  if (debug_lvl <= 0) return;
+
+  if (debug_lvl & 1) { // Standard console startup message output
+    if (from == 0) { // Constructor
+      FGLogging log(LogLevel::DEBUG);
+      log << "      INPUT: " << InputNodes[0]->GetName() << "\n";
+      log << "      SAMPLES: " << buffer.size() << "\n";
+      for (auto node: OutputNodes)
+        log << "      OUTPUT: " << node->getNameString() << "\n";
+    }
+  }
+  if (debug_lvl & 2 ) { // Instantiation/Destruction notification
+    FGLogging log(LogLevel::DEBUG);
+    if (from == 0) log << "Instantiated: FGMovingAverage\n";
+    if (from == 1) log << "Destroyed:    FGMovingAverage\n";
+  }
+}
+}
